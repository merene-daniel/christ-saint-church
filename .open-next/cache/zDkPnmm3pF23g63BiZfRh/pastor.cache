{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/pastor/layout,_N_T_/pastor/page,_N_T_/pastor"},"segmentPaths":["/_tree","/_full","/pastor/__PAGE__","/pastor","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"am\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=1080&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0545sz-1dqlt4.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/2zjueh7t2vecu.js\"/><script src=\"/_next/static/chunks/3zw6u-rg6kaml.js\" async=\"\"></script><script src=\"/_next/static/chunks/3peubv2924kx4.js\" async=\"\"></script><script src=\"/_next/static/chunks/1_zmgipypuk59.js\" async=\"\"></script><script src=\"/_next/static/chunks/27jktro2p5rq9.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0k4998psl_953.js\" async=\"\"></script><script src=\"/_next/static/chunks/3bk0cpzuomv-5.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mrh2-p_w84d.js\" async=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&amp;family=Noto+Serif+Ethiopic:wght@300;400;600;700&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;display=swap\" as=\"style\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>Pastor Beza Merne | Christ Saints&#x27; Church</title><meta name=\"description\" content=\"ፍቅር፣ ተስፋ፣ ሕይወት — ክርስቶስ ቅዱሳን ቤተክርስቲያን አዲስ አበባ\"/><link rel=\"icon\" href=\"/images/logo.png\"/><link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&amp;family=Noto+Serif+Ethiopic:wght@300;400;600;700&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-body bg-cream text-text-warm antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent\"><div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\"><a class=\"flex items-center gap-3 group\" href=\"/\"><div class=\"relative w-12 h-12 rounded-full border-2 border-gold overflow-hidden group-hover:border-gold-light transition-colors\"><img alt=\"Christ Saints&#x27; Church\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75\"/></div><div><span class=\"font-display text-gold text-base font-bold tracking-wide block leading-tight\">Christ Saints&#x27; Church</span><span class=\"font-body text-white/50 text-xs\">ክርስቶስ ቅዱሳን ቤተክርስቲያን</span></div></a><ul class=\"hidden lg:flex items-center gap-8\"><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/\"><span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/about\">About<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/pastor\">Pastors<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/sermons\">Sermons<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/events\">Events<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/contact\">Contact<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li></ul><button class=\"lg:hidden text-white p-2\" aria-label=\"Toggle menu\"><div class=\"w-6 h-0.5 bg-white mb-1.5 transition-all \"></div><div class=\"w-6 h-0.5 bg-white mb-1.5 transition-all \"></div><div class=\"w-6 h-0.5 bg-white transition-all \"></div></button></div><div class=\"lg:hidden overflow-hidden transition-all duration-300 bg-church-dark/98 border-t border-gold/10 max-h-0 opacity-0\"><ul class=\"px-6 py-4 space-y-4\"><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/\"></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/about\">About</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/pastor\">Pastors</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/sermons\">Sermons</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/events\">Events</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/contact\">Contact</a></li><li><a class=\"inline-block bg-church-blue text-white px-6 py-2.5 font-body text-sm mt-2\" href=\"/contact\">Join Us</a></li></ul></div></nav><main><section class=\"relative py-40 px-6 bg-hero-gradient text-center overflow-hidden\"><div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(13,27,62,0.5)_0%,transparent_70%)] pointer-events-none\"></div><div class=\"relative z-10\"><p class=\"font-accent text-gold/75 uppercase tracking-[5px] text-sm mb-4\">Meet Our Pastor</p><h1 class=\"font-display text-5xl md:text-6xl text-white font-black\">ፓስተር <span class=\"text-shimmer\">ቤዛ መርኔ</span></h1><p class=\"font-body text-white/50 text-lg mt-3\">Pastor Beza Merne — Lead Pastor</p></div></section><section class=\"py-24 px-6 bg-white\"><div class=\"max-w-5xl mx-auto\"><div class=\"grid grid-cols-1 lg:grid-cols-5 gap-16 items-start\"><div class=\"lg:col-span-2\"><div class=\"relative\"><div class=\"absolute -inset-6 border border-gold/25\"></div><div class=\"relative\"><img alt=\"Pastor Beza Merne\" width=\"500\" height=\"650\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-cover object-top\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=1080&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=1080&amp;q=75\"/></div><div class=\"absolute -bottom-6 -right-6 bg-church-blue text-white p-5 shadow-xl\"><p class=\"font-display text-lg font-bold\">ፓስተር ቤዛ መርኔ</p><p class=\"font-accent italic text-white/70 text-sm\">Lead Pastor</p></div></div></div><div class=\"lg:col-span-3 pt-4\"><span class=\"font-accent text-church-blue uppercase tracking-[4px] text-xs block mb-3\">Biography</span><h2 class=\"font-display text-4xl text-church-dark font-bold mb-6\">ስለ ፓስተሩ <span class=\"text-2xl text-[#9a8a80] font-normal\">/ About the Pastor</span></h2><div class=\"w-12 h-0.5 bg-gradient-to-r from-church-blue to-gold mb-8\"></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\"><div class=\"space-y-5 font-body text-[#5a4a40] text-sm leading-relaxed\"><p>Pastor Beza Taye Merne was born and raised in Eastern Ethiopia. He completed his secondary education in the city of Dire Dawa and earned a Bachelor&#x27;s Degree in Theology from the Meserete Kristos Church Seminary in Bishoftu (formerly Debre Zeit), Ethiopia.</p><p>For sixteen years, Pastor Beza faithfully served as a pastor and church planter among Meserete Kristos churches throughout Eastern Ethiopia, dedicating his life to evangelism, discipleship, and church growth. In 2019, following God&#x27;s calling and the leading of the Holy Spirit, he and his wife, Yetnait Weldegiorgis, relocated to Alexandria, Virginia. Together, they founded Christ Saints&#x27; Church, where Pastor Beza continues to serve as the founding pastor and spiritual leader.</p><p>Pastor Beza is a devoted husband and loving father. He is deeply committed to sharing the Gospel of Jesus Christ, equipping believers for spiritual growth, and serving people with compassion and humility. His greatest joy is seeing lives transformed by Christ, witnessing individuals come to faith, and helping them grow into mature disciples who faithfully follow Jesus. Through his ministry, he strives to glorify God and inspire others to live with faith, hope, and purpose in Christ.</p></div><div class=\"space-y-5 font-body text-[#5a4a40] text-sm leading-relaxed\"><p>ፓስተር ቤዛ ታዬ  መርኔ በምስራቅ ኢትዮጵያ ተወልደው እና አድገዋል። የሁለተኛ ደረጃ ትምህርታቸውን በድሬዳዋ ከተማ አጠናቀው፣ ከመሰረተ ክርስቶስ ቤተ ክርስቲያን ሴሚናሪ (ቢሾፍቱ/ደብረ ዘይት) በሥነ መለኮት (Theology) የባችለር ዲግሪ አግኝተዋል።</p><p>ፓስተር ቤዛ በምስራቅ ኢትዮጵያ በሚገኙ የመሰረተ ክርስቶስ አብያተ ክርስቲያናት ውስጥ ለ16 ዓመታት በታማኝነት እንደ ፓስተርና አዲስ ቤተ ክርስቲያን ተክላይ (Church Planter) አገልግለዋል። በ2019 ዓ.ም. በእግዚአብሔር ጥሪና በመንፈስ ቅዱስ ምሪት፣ ከባለቤታቸው ከወ/ሮ የትናይት ወልደ ጊዮርጊስ ጋር ወደ አሌክሳንድሪያ፣ ቨርጂኒያ ተዛውረዋል። የክርስቶስ መሠረት ቤተክርስቲያንን  መስርተው እስከ ዛሬ ድረስ እንደ መሥራች እና ዋና ፓስተር በትጋት እያገለገሉ ይገኛሉ።</p><p>ፓስተር ቤዛ  ታማኝ ባልና የቤተሰብ ኃላፊ ናቸው። ወንጌልን በታማኝነት ለማወጅ፣ አማኞችን በእምነታቸው ለማሳደግ እና ሰዎችን በፍቅርና በትሕትና ለማገልገል በጥልቅ የተሰጡ ናቸው። ሰዎች ክርስቶስን እንዲያውቁ፣ ሕይወታቸው በእርሱ እንዲለወጥ እና የኢየሱስ ክርስቶስ ደቀ መዛሙርት ሆነው እንዲያድጉ ማየት ታላቅ ደስታቸው ነው። በአገልግሎታቸው ሁሉ እግዚአብሔርን ለማክበር እና ሌሎችን በእምነት፣ በተስፋ እና በክርስቶስ ዓላማ የተሞላ ሕይወት እንዲኖሩ ለማነሳሳት ይተጋሉ።</p></div></div></div></div></div></section><section class=\"py-20 px-6 bg-cream\"><div class=\"max-w-3xl mx-auto text-center\"><span class=\"font-accent text-church-blue uppercase tracking-[4px] text-xs block mb-4\">Message from the Pastor</span><h2 class=\"font-display text-4xl text-church-dark font-bold mb-6\">A Word from the Pastor</h2><div class=\"w-12 h-0.5 bg-gold mx-auto mb-8\"></div><div class=\"bg-white p-10 border border-gold/20 shadow-md relative\"><div class=\"absolute top-4 left-6 text-8xl font-serif text-gold/10 leading-none select-none\">“</div><p class=\"font-body text-[#5a4a40] leading-relaxed text-sm relative z-10 mb-4\">Welcome to Christ Saints&#x27; Church. This is a house open to everyone — the long-time believer and the first-time visitor, the strong and the weary. Jesus tells us He receives all who come to Him.</p><p class=\"font-body text-[#5a4a40] leading-relaxed text-sm\">Together we grow in the Lord — hearing His Word, lifting our prayers, and extending His love to one another. Through Christ, our lives are transformed. The family is waiting for you!</p><div class=\"mt-6 pt-6 border-t border-gold/20 text-right\"><p class=\"font-display text-church-dark font-bold\">ፓስተር ቤዛ መርኔ</p><p class=\"font-accent italic text-church-blue text-sm\">Lead Pastor, Christ Saints&#x27; Church</p></div></div></div></section><!--$--><!--/$--></main><footer class=\"bg-church-dark border-t border-gold/15\"><div class=\"max-w-7xl mx-auto px-6 py-16\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\"><div><div class=\"flex items-center gap-3 mb-4\"><div class=\"relative w-14 h-14 rounded-full border-2 border-gold overflow-hidden\"><img alt=\"Logo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75\"/></div><div><p class=\"font-display text-gold text-base font-bold\">Christ Saints&#x27; Church</p><p class=\"font-body text-white/40 text-xs\">ክርስቶስ ቅዱሳን ቤተክርስቲያን</p></div></div><p class=\"font-body text-white/50 text-sm leading-relaxed mt-4\">ፍቅር፣ ተስፋ፣ ሕይወት — በኢየሱስ ክርስቶስ ስም አብሮ እናገለግላለን።</p></div><div><h4 class=\"font-accent text-gold text-lg mb-5 tracking-widest uppercase text-sm\">Links</h4><ul class=\"space-y-3\"><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/about\">About</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/pastor\">Pastor</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/sermons\">Sermons</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/events\">Events</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/contact\">Contact</a></li></ul></div><div><h4 class=\"font-accent text-gold tracking-widest uppercase text-sm mb-5\">Worship Schedule</h4><div class=\"space-y-3\"><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Sunday<!-- --> — <!-- -->2:00 - 4:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Worship</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Wednesday<!-- --> — <!-- -->7:00 - 8:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Bible Study</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Saturday<!-- --> — <!-- -->11:00 AM - 1:00 PM</span><span class=\"font-body text-white/35 text-xs block\">Prayer Meeting (Every Two Weeks)</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Sunday<!-- --> — <!-- -->2:00 - 4:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Youth Group (Sunday School)</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Saturday<!-- --> — <!-- -->11:00 AM - 7:00 PM</span><span class=\"font-body text-white/35 text-xs block\">Evangelism (Every Two Weeks)</span></div></div></div></div></div><div class=\"mt-12 pt-6 border-t border-gold/10 flex flex-col md:flex-row justify-between items-center gap-4\">