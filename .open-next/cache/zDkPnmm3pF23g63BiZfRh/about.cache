{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"segmentPaths":["/_tree","/_full","/about/__PAGE__","/about","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"am\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0545sz-1dqlt4.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/2zjueh7t2vecu.js\"/><script src=\"/_next/static/chunks/3zw6u-rg6kaml.js\" async=\"\"></script><script src=\"/_next/static/chunks/3peubv2924kx4.js\" async=\"\"></script><script src=\"/_next/static/chunks/1_zmgipypuk59.js\" async=\"\"></script><script src=\"/_next/static/chunks/27jktro2p5rq9.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0k4998psl_953.js\" async=\"\"></script><script src=\"/_next/static/chunks/3bk0cpzuomv-5.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mrh2-p_w84d.js\" async=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&amp;family=Noto+Serif+Ethiopic:wght@300;400;600;700&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;display=swap\" as=\"style\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>ስለ እኛ | Christ Saints&#x27; Church</title><meta name=\"description\" content=\"ፍቅር፣ ተስፋ፣ ሕይወት — ክርስቶስ ቅዱሳን ቤተክርስቲያን አዲስ አበባ\"/><link rel=\"icon\" href=\"/images/logo.png\"/><link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&amp;family=Noto+Serif+Ethiopic:wght@300;400;600;700&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-body bg-cream text-text-warm antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent\"><div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\"><a class=\"flex items-center gap-3 group\" href=\"/\"><div class=\"relative w-12 h-12 rounded-full border-2 border-gold overflow-hidden group-hover:border-gold-light transition-colors\"><img alt=\"Christ Saints&#x27; Church\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75\"/></div><div><span class=\"font-display text-gold text-base font-bold tracking-wide block leading-tight\">Christ Saints&#x27; Church</span><span class=\"font-body text-white/50 text-xs\">ክርስቶስ ቅዱሳን ቤተክርስቲያን</span></div></a><ul class=\"hidden lg:flex items-center gap-8\"><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/\"><span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/about\">About<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/pastor\">Pastors<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/sermons\">Sermons<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/events\">Events<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/contact\">Contact<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li></ul><button class=\"lg:hidden text-white p-2\" aria-label=\"Toggle menu\"><div class=\"w-6 h-0.5 bg-white mb-1.5 transition-all \"></div><div class=\"w-6 h-0.5 bg-white mb-1.5 transition-all \"></div><div class=\"w-6 h-0.5 bg-white transition-all \"></div></button></div><div class=\"lg:hidden overflow-hidden transition-all duration-300 bg-church-dark/98 border-t border-gold/10 max-h-0 opacity-0\"><ul class=\"px-6 py-4 space-y-4\"><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/\"></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/about\">About</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/pastor\">Pastors</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/sermons\">Sermons</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/events\">Events</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/contact\">Contact</a></li><li><a class=\"inline-block bg-church-blue text-white px-6 py-2.5 font-body text-sm mt-2\" href=\"/contact\">Join Us</a></li></ul></div></nav><main><section class=\"relative py-40 px-6 bg-hero-gradient text-center overflow-hidden\"><div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(139,26,26,0.3)_0%,transparent_70%)] pointer-events-none\"></div><div class=\"relative z-10 max-w-3xl mx-auto\"><p class=\"font-accent text-gold/75 uppercase tracking-[5px] text-sm mb-4\">About Us</p><h1 class=\"font-display text-5xl md:text-6xl text-white font-black mb-6\">ስለ <span class=\"text-shimmer\">ቤተክርስቲያናችን</span></h1><p class=\"font-body text-white/60 text-base leading-relaxed\">ክርስቶስ ቅዱሳን ቤተክርስቲያን — ፍቅር፣ ተስፋ፣ እና ሕይወት የሚሰፍንበት ቅዱስ ቤት</p></div></section><section class=\"py-24 px-6 bg-white\"><div class=\"max-w-4xl mx-auto\"><div class=\"mb-16\"><span class=\"font-accent text-church-blue uppercase tracking-[4px] text-xs block mb-3\">Mission</span><h2 class=\"font-display text-4xl text-church-dark font-bold mb-4\">ተልዕኳችን</h2><div class=\"w-12 h-0.5 bg-church-blue mb-6\"></div><p class=\"font-body text-[#5a4a40] leading-relaxed mb-3 text-base\">We exist to glorify God by leading every person to believe in Jesus Christ and by discipling them.</p><p class=\"font-body text-[#5a4a40] leading-relaxed text-sm italic border-l-4 border-gold pl-4\">በሁሉም ሥፍራ በሁሉም አጋጣሚ የክርስቶስን ኢየሱስ የማዳኑን ወንጌል ለሠዎች ሁሉ በማድረስ እግዚአብሔርን ማክበር</p></div><div><span class=\"font-accent text-church-blue uppercase tracking-[4px] text-xs block mb-3\">Vision</span><h2 class=\"font-display text-4xl text-church-dark font-bold mb-4\">ራዕያችን</h2><div class=\"w-12 h-0.5 bg-church-blue mb-6\"></div><p class=\"font-body text-[#5a4a40] leading-relaxed mb-3 text-base\">We are committed to helping every person to believe in Jesus and equipping them to become a disciple of Christ — we encourage multitudes through the Gospel of Jesus Christ for eternal salvation.</p><p class=\"font-body text-[#5a4a40] leading-relaxed text-sm italic border-l-4 border-gold pl-4\">ሠዎች በክርስቶስ ኢየሱስ ያምኑ ዘንድ መመስከር እና ደቀመዛሙርት እንዲሆኑ ማብቃት</p></div></div></section><section class=\"py-24 px-6 bg-cream\"><div class=\"text-center mb-16\"><span class=\"font-accent uppercase tracking-[4px] text-xs block mb-3 text-crimson\">አገልግሎቶቻችን</span><h2 class=\"font-display text-4xl md:text-5xl font-bold leading-tight text-church-dark\">ምን እናደርጋለን?</h2><div class=\"w-16 h-0.5 bg-gradient-to-r from-crimson to-gold mx-auto my-5\"></div><p class=\"font-body max-w-xl mx-auto leading-relaxed text-base text-warm-600\" style=\"color:#6a5a50\">ቤተክርስቲያናችን ብዙ ዘርፎች ይዛ ሕዝቡን ታሳድጋለች</p></div><div class=\"max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"bg-white p-7 border-b-4 border-church-blue hover:shadow-lg hover:-translate-y-1 transition-all duration-300\"><div class=\"text-4xl mb-4\">🕊️</div><h3 class=\"font-display text-xl text-church-dark mb-2\">አምልኮ</h3><p class=\"font-body text-[#6a5a50] text-sm leading-relaxed\">ለእግዚአብሔር ምስጋናና ጸሎት አቀርቦ ቤተሰቡን ሁሉ ለፍቅሩ ቅርብ ያደርጋል።</p></div><div class=\"bg-white p-7 border-b-4 border-church-blue hover:shadow-lg hover:-translate-y-1 transition-all duration-300\"><div class=\"text-4xl mb-4\">📖</div><h3 class=\"font-display text-xl text-church-dark mb-2\">ቃሉ</h3><p class=\"font-body text-[#6a5a50] text-sm leading-relaxed\">ቅዱስ መጽሐፍን ጥልቅ ወደሆነ ጥናት ምርምር ይመራናል።</p></div><div class=\"bg-white p-7 border-b-4 border-church-blue hover:shadow-lg hover:-translate-y-1 transition-all duration-300\"><div class=\"text-4xl mb-4\">👶</div><h3 class=\"font-display text-xl text-church-dark mb-2\">ሕፃናት</h3><p class=\"font-body text-[#6a5a50] text-sm leading-relaxed\">ሕፃናት ኢየሱስን ቀደም ብለው ያውቁ ዘንድ ዕድሜ ለዕድሜ ትምህርት ይሰጣቸዋል።</p></div><div class=\"bg-white p-7 border-b-4 border-church-blue hover:shadow-lg hover:-translate-y-1 transition-all duration-300\"><div class=\"text-4xl mb-4\">🌍</div><h3 class=\"font-display text-xl text-church-dark mb-2\">ወንጌል</h3><p class=\"font-body text-[#6a5a50] text-sm leading-relaxed\">ወንጌልን ወደ አካባቢው ማኅበረሰብ ማዳረስ ዋና ተልዕኮዎቻችን ናቸው።</p></div><div class=\"bg-white p-7 border-b-4 border-church-blue hover:shadow-lg hover:-translate-y-1 transition-all duration-300\"><div class=\"text-4xl mb-4\">💑</div><h3 class=\"font-display text-xl text-church-dark mb-2\">ቤተሰብ</h3><p class=\"font-body text-[#6a5a50] text-sm leading-relaxed\">ቤተሰቦች አብሮ ወደ ክርስቶስ ሲያድጉ ቤተክርስቲያናችን ትደሰታለች።</p></div><div class=\"bg-white p-7 border-b-4 border-church-blue hover:shadow-lg hover:-translate-y-1 transition-all duration-300\"><div class=\"text-4xl mb-4\">🎵</div><h3 class=\"font-display text-xl text-church-dark mb-2\">ምስጋና</h3><p class=\"font-body text-[#6a5a50] text-sm leading-relaxed\">ምስጋናው ቡድን ያጅብናል — ቅዱስ ዜማ ሕዝቡን ወደ ፊቱ ያቀርባል።</p></div></div></section><section class=\"py-24 px-6 bg-white\"><div class=\"max-w-4xl mx-auto\"><span class=\"font-accent text-church-blue uppercase tracking-[4px] text-xs block mb-3 text-center\">What We Believe</span><h2 class=\"font-display text-4xl text-church-dark font-bold mb-4 text-center\">Faith Statements</h2><div class=\"w-12 h-0.5 bg-church-blue mb-12 mx-auto\"></div><div class=\"space-y-8\"><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">1</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe that the Bible is the inspired, trustworthy and truth without error, word of God (2 Tim 3:16-17).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">መጽሐፍ ቅዱስ በእግዚአብሔር መንፈስ መንዳትና መሪነት የተጻፈ እንደሆነና ምንም አይነት ስህተት የሌለበት እንደሆነ እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">2</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe there is only one God who eternally exists in three Persons: Father, Son, and Holy Spirit (Matt 28:19).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">አንድ ዘላለማዊ እና መለኮታዊ አምላክ በሶስት አካል የተገለጠ (አብ ውልድ እና መንፈስ ቅዱስ) እንደሆነ እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">3</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe Jesus Christ is God, born of the virgin Mary, lived a sinless life, performed miracles, died on the cross for our sins, bodily resurrected, ascended, and will return with power and glory (John 1:1; Matt 1:19,25; Heb 4:15; Heb 9:15-22; 1Cor 15:1-8; Acts 1:9-11; Heb 9:27-28).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">እየሱስ ክርስቶስ አምላክ፣ የእግዚአብሔር ልጅ እንደሆነ፤ ፍጹም አምላክ፣ ፍጹም ሰው መሆኑን፣ ምንም ኃጢያት የሌለበት መሆኑን፤ በመስቀል ላይ ተሰቅሎ ሞቶ ተነስቶ እዳችንን እንደከፈለ፣ ከሞት እንደተነሣ፣ በደሙ ኃጤያታችንን ሁሉ እንዳስወገደ፤ ወደሰማይ እንዳረገ፣ በክብር ተመልሶ እንደሚመጣ እናምናለን።</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">4</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe accepting Jesus Christ as Lord and personal Savior and corresponding renewal by the Holy Spirit are the only path to salvation (John 3:16; John 5:24; Titus 3:3-7).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">በኃጢአት ምክንያት ከዘላለም ሕይዎት የተለዩ ሠዎችን ሊያድን የሚችለው በክርስቶስ ኢየሱስ አዳኝነት ማመንና በመንፈስ ቅዱስ የሆነ መታደስ እንደሆነ እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">5</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe in the present ministry of the Holy Spirit, who lives within and guides Christians so they are enabled to live godly lives (John 14:14-16; John 16:5-16; Eph 1:13-14).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">በመንፈስ ቅዱስ መሪነት፣ አስተማሪነት፣ ኃይል ሰጪነት እና አገልግሎት እናምናለን።</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">6</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe in eternal life (Matt 25:31-46; 1 Thess 4:13).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">በዘላለማዊ ሕይወት እናምናለን።</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">7</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe in the spiritual unity of believers in our Lord Jesus Christ — that all believers are members of His body, the church (Phil 2:1-4).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">በክርስቶስ ያመኑ አማኞች ሁሉ የክርስቶስ አካል የሆነችው ቤተክርስቲያን አካል፣ አንድ ቤተሰብ እንደሆንን እናምናለን።</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">8</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe God&#x27;s design for sexual intimacy is to be expressed only within the context of marriage between one man and one woman. Marriage is exclusively the union between one man and one woman (Gen 2:24; Matt 19:5-6; Mark 10:6-9; Rom 1:26-27; 1Cor 6:9).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">ጋብቻ በአንድ ሴት እና አንድ ወንድ መካከል ብቻ መሆኑን እና ግብረስጋ ግንኙነት ከተጋቡ ቡኋላ በእነሱ መካከል መሆኑን እናምናለን።</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">9</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe God created all human beings in His image; therefore human life is sacred from conception to its natural end. Every person should be treated with love, dignity, and respect (Psalm 139:1-24; Isa 49:1; Jer 22:37-39; Rom 12:20-21; Gal 6:10).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">ሰው ሁሉ በእግዚአብሔር አምሳል የተፈጠረ ስለሆነ እኩል ፍቀር ሊሰጠው እንደሚገባው መንፈሳዊም ስጋዊም ፍላጎቱ ሊከበርለት እንደሚገባው እናምናለን።</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">10</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe that salvation is a gift from God to man. Man can never make up for his sin by self-improvement or good works — only by trusting in Jesus Christ can man be saved. Eternal life begins at the moment one receives Jesus Christ by faith (Rom 6:23; Eph 2:8-9; John 14:6; Titus 3:5; Gal 3:26; Rom 5:1).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">ከኃጢያት እና ከዘላለም ሞት ፍርድ መዳን ሰው ፈጽሞ በመልካም ስራው በራሱ ጥረት ሊያገኘው እንደማይችል ኢየሱስን በማመን ብቻ የሚገኝ የእግዚአብሔር ነጻ ስጦታ መሆኑን እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">11</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe the Holy Spirit is present in the world to make people aware of their need for Jesus Christ. He lives in every Christian from the moment of salvation.</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">መንፈስ ቅዱስ ሰዎችን ሁሉ በኃጥያታቸው በመወቅስ እና ወደ እውነት እና ንሰኃ እንደሚመራ እናምናለን፤ እየሱስ ክርስቶስን አምነው የተቀበሉት ሁሉ ውስጥ እንደሚኖር እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">12</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe water baptism is a biblical command and demonstration of our love and obedience to Christ. Baptism by immersion symbolizes the death, burial, and resurrection of Jesus Christ and is the public declaration that we have accepted Jesus as our personal Savior (Col 2:12; Acts 2:41; Eph 2:8-9; Matt 28:19-20).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">ጥምቀት መጽሐፍ ቅዱሳዊ ትዛዝ እንደሆነ ሁሉም እየሱስን አምኖ የተቀበለ፣ የክርስቶስን ሞትና ትንሣኤ መተባበር እንዳለበት ያመነ የሚወስደው መሆኑን እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">13</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe in adult baptism — it is provided for those who receive Jesus Christ as their personal Savior.</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">ሰዎች በኃጥያታቸው ንሰኃ ገብተው እየሱስን አምነው ተቀብለው ለመከተል ከወሰኑ ቡሓላ በማጥመቅ እናምናለን</p></div></div><div class=\"flex gap-6 pb-8 border-b border-gray-100 last:border-0\"><div class=\"flex-shrink-0 w-8 h-8 bg-church-blue text-white text-sm font-bold font-display flex items-center justify-center\">14</div><div><p class=\"font-body text-[#3a2a20] text-sm leading-relaxed mb-2\">We believe in Holy Communion: the Lord&#x27;s Supper is an ordinance given to all believers by Jesus Christ to remember His sacrifice and symbolizes the new covenant. The bread and wine (or juice) are symbols of Christ&#x27;s broken body and shed blood. Communion is not a means of salvation; it is a testimony of a believer&#x27;s faith in the atoning work of the cross (Matt 26:26-30; Mark 14:22-26; Luke 22:19-20).</p><p class=\"font-body text-[#7a6a60] text-sm leading-relaxed italic\">የጌታ እራት ለአማኞች ኢየሱስ የከፈለልንን መከራ ለማስታወስ የተሰጠ ትዛዝ ሲሆን፣ የአዲሱ ኪዳን ምልክት ነው። ኅብስቱ እና ጽዋው የክርስቶስ አካልና ደም ምሳሌዎች ናቸው። ቁርባን ድኅነትን ለማግኘት ሳይሆን የአማኝ ሃይማኖቱን ለመመስከር የሚፈጸም ነው።</p></div></div></div></div></section><!--$--><!--/$--></main><footer class=\"bg-church-dark border-t border-gold/15\"><div class=\"max-w-7xl mx-auto px-6 py-16\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\"><div><div class=\"flex items-center gap-3 mb-4\"><div class=\"relative w-14 h-14 rounded-full border-2 border-gold overflow-hidden\"><img alt=\"Logo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75\"/></div><div><p class=\"font-display text-gold text-base font-bold\">Christ Saints&#x27; Church</p><p class=\"font-body text-white/40 text-xs\">ክርስቶስ ቅዱሳን ቤተክርስቲያን</p></div></div><p class=\"font-body text-white/50 text-sm leading-relaxed mt-4\">ፍቅር፣ ተስፋ፣ ሕይወት — በኢየሱስ ክርስቶስ ስም አብሮ እናገለግላለን።</p></div><div><h4 class=\"font-accent text-gold text-lg mb-5 tracking-widest uppercase text-sm\">Links</h4><ul class=\"space-y-3\"><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/about\">About</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/pastor\">Pastor</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/sermons\">Sermons</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/events\">Events</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/contact\">Contact</a></li></ul></div><div><h4 class=\"font-accent text-gold tracking-widest uppercase text-sm mb-5\">Worship Schedule</h4><div class=\"space-y-3\"><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Sunday<!-- --> — <!-- -->2:00 - 4:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Worship</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Wednesday<!-- --> — <!-- -->7:00 - 8:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Bible Study</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Saturday<!-- --> — <!-- -->11:00 AM - 1:00 PM</span><span class=\"font-body text-white/35 text-xs block\">Prayer Meeting (Every Two Weeks)</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Sunday<!-- --> — <!-- -->2:00 - 4:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Youth Group (Sunday School)</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Saturday<!-- --> — <!-- -->11:00 AM - 7:00 PM</span><span class=\"font-body text-white/35 text-xs block\">Evangelism (Every Two Weeks)</span></div></div></div></div></div><div class=\"mt-12 pt-6 border-t border-gold/10 flex flex-col md:flex-row justify-between items-center gap-4\"><p class=\"font-body text-white/30 text-xs\">© <!-- -->2026<!-- -->Christ Saints&#x27; Church. ሁሉም መብቶች የተጠበቁ ናቸው።</p><p class=\"font-accent italic text-gold/40 text-sm\">“ኢየሱስ ክርስቶስ ትናንትና ዛሬ ለዘለዓለምም አንድ ነው” — ዕብ 13:8</p></div></div></footer><script src=\"/_next/static/chunks/2zjueh7t2vecu.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[62319,[\\\"/_next/static/chunks/3bk0cpzuomv-5.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\"],\\\"default\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/3bk0cpzuomv-5.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/3bk0cpzuomv-5.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\"],\\\"default\\\"]\\n5:I[5500,[\\\"/_next/static/chunks/3bk0cpzuomv-5.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\"],\\\"Image\\\"]\\n6:I[22016,[\\\"/_next/static/chunks/3bk0cpzuomv-5.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\"],\\\"\\\"]\\nd:I[68027,[\\\"/_next/static/chunks/3bk0cpzuomv-5.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/0545sz-1dqlt4.css\\\",\\\"style\\\"]\\n:HL[\\\"https://fonts.googleapis.com/css2?family=Playfair+Displ