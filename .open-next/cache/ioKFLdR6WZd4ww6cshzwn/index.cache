n class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/pastor\">Pastors<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/sermons\">Sermons<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/events\">Events<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors text-sm tracking-wide relative group\" href=\"/contact\">Contact<span class=\"absolute -bottom-1 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a></li></ul><button class=\"lg:hidden text-white p-2\" aria-label=\"Toggle menu\"><div class=\"w-6 h-0.5 bg-white mb-1.5 transition-all \"></div><div class=\"w-6 h-0.5 bg-white mb-1.5 transition-all \"></div><div class=\"w-6 h-0.5 bg-white transition-all \"></div></button></div><div class=\"lg:hidden overflow-hidden transition-all duration-300 bg-church-dark/98 border-t border-gold/10 max-h-0 opacity-0\"><ul class=\"px-6 py-4 space-y-4\"><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/\"></a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/about\">About</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/pastor\">Pastors</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/sermons\">Sermons</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/events\">Events</a></li><li><a class=\"font-body text-white/80 hover:text-gold transition-colors block py-1 text-base\" href=\"/contact\">Contact</a></li><li><a class=\"inline-block bg-church-blue text-white px-6 py-2.5 font-body text-sm mt-2\" href=\"/contact\">Join Us</a></li></ul></div></nav><main><section class=\"relative min-h-screen flex items-center justify-center overflow-hidden bg-hero-gradient\"><div class=\"absolute inset-0 pointer-events-none\"><div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(30,108,184,0.35)_0%,transparent_60%)]\"></div><div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_70%_30%,rgba(13,27,62,0.5)_0%,transparent_60%)]\"></div><div class=\"absolute inset-0 hidden md:flex items-center justify-center pointer-events-none select-none\"><span class=\"text-[40vw] font-serif text-white/[0.02] leading-none animate-float\">✝</span></div><div class=\"absolute inset-0 opacity-[0.03]\" style=\"background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox=&#x27;0 0 200 200&#x27; xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%3E%3Cfilter id=&#x27;n&#x27;%3E%3CfeTurbulence type=&#x27;fractalNoise&#x27; baseFrequency=&#x27;0.9&#x27; numOctaves=&#x27;4&#x27; stitchTiles=&#x27;stitch&#x27;/%3E%3C/filter%3E%3Crect width=&#x27;100%25&#x27; height=&#x27;100%25&#x27; filter=&#x27;url(%23n)&#x27;/%3E%3C/svg%3E&quot;)\"></div></div><div class=\"relative z-10 text-center px-6 max-w-4xl mx-auto pt-24 pb-16\"><p class=\"font-accent text-gold/80 text-sm md:text-base tracking-[5px] uppercase mb-4 animate-fade-in\">እንኳን ደህና መጣችሁ</p><h1 class=\"font-display text-5xl md:text-7xl font-black text-white leading-tight mb-3\">Christ Saints&#x27;<!-- --> <span class=\"text-shimmer\">Church</span></h1><p class=\"font-body text-white/60 text-xl md:text-2xl mb-8\">ክርስቶስ ቅዱሳን ቤተክርስቲያን</p><div class=\"inline-block border-l-2 border-gold text-left pl-6 mb-10 max-w-xl\"><p class=\"font-accent italic text-gold/75 text-lg leading-relaxed\">“እግዚአብሔር ፍቅር ነው፤ የሚኖርበት ሰው ሁሉ በፍቅር ይኖራል፣ እግዚአብሔርም በእርሱ ይኖራል።”</p><span class=\"font-accent text-gold/40 text-sm mt-1 block\">— ፩ ዮሐ 4:16</span></div><div class=\"flex flex-wrap gap-4 justify-center\"><a class=\"bg-church-blue hover:bg-church-blue-light text-white font-body px-8 py-3.5 transition-all duration-300 hover:shadow-xl hover:shadow-church-blue/40 hover:-translate-y-1\" href=\"/about\">About Us</a><a class=\"border border-gold text-gold hover:bg-gold hover:text-church-dark font-body px-8 py-3.5 transition-all duration-300\" href=\"/contact\">Contact</a></div></div><div class=\"absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce\"><span class=\"font-accent text-gold/40 text-xs tracking-widest\">SCROLL</span><div class=\"w-px h-8 bg-gradient-to-b from-gold/40 to-transparent\"></div></div></section><section class=\"bg-[#0D1B3E] py-20 px-6\"><div class=\"max-w-5xl mx-auto\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\"><div class=\"bg-gradient-to-br from-church-blue to-church-blue-dark p-6 border border-white/5 hover:-translate-y-1 transition-transform\"><div class=\"text-3xl mb-3\">🕊️</div><h3 class=\"font-body text-white text-base font-semibold mb-1\">Worship</h3><p class=\"font-accent text-gold text-lg italic\">Sunday</p><p class=\"font-body text-white/60 text-sm\">2:00 - 4:30 PM</p></div><div class=\"bg-gradient-to-br from-deep-blue to-blue-900 p-6 border border-white/5 hover:-translate-y-1 transition-transform\"><div class=\"text-3xl mb-3\">📖</div><h3 class=\"font-body text-white text-base font-semibold mb-1\">Bible Study</h3><p class=\"font-accent text-gold text-lg italic\">Wednesday</p><p class=\"font-body text-white/60 text-sm\">7:00 - 8:30 PM</p></div><div class=\"bg-gradient-to-br from-emerald-800 to-emerald-900 p-6 border border-white/5 hover:-translate-y-1 transition-transform\"><div class=\"text-3xl mb-3\">🙏</div><h3 class=\"font-body text-white text-base font-semibold mb-1\">Prayer Meeting (Every Two Weeks)</h3><p class=\"font-accent text-gold text-lg italic\">Saturday</p><p class=\"font-body text-white/60 text-sm\">11:00 AM - 1:00 PM</p></div><div class=\"bg-gradient-to-br from-purple-900 to-purple-950 p-6 border border-white/5 hover:-translate-y-1 transition-transform\"><div class=\"text-3xl mb-3\">🎵</div><h3 class=\"font-body text-white text-base font-semibold mb-1\">Youth Group (Sunday School)</h3><p class=\"font-accent text-gold text-lg italic\">Sunday</p><p class=\"font-body text-white/60 text-sm\">2:00 - 4:30 PM</p></div><div class=\"bg-gradient-to-br from-gray-400 to-gray-500 p-6 border border-white/5 hover:-translate-y-1 transition-transform\"><div class=\"text-3xl mb-3\">📖</div><h3 class=\"font-body text-white text-base font-semibold mb-1\">Evangelism (Every Two Weeks)</h3><p class=\"font-accent text-gold text-lg italic\">Saturday</p><p class=\"font-body text-white/60 text-sm\">11:00 AM - 7:00 PM</p></div></div></div></section><section class=\"py-24 px-6 bg-white\"><div class=\"text-center mb-16\"><span class=\"font-accent uppercase tracking-[4px] text-xs block mb-3 text-crimson\">Our Core Values</span><h2 class=\"font-display text-4xl md:text-5xl font-bold leading-tight text-church-dark\">What Defines Us</h2><div class=\"w-16 h-0.5 bg-gradient-to-r from-crimson to-gold mx-auto my-5\"></div><p class=\"font-body max-w-xl mx-auto leading-relaxed text-base text-warm-600\" style=\"color:#6a5a50\">Our church stands on three foundational pillars</p></div><div class=\"max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-white p-8 border-b-4 border-church-blue shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center\"><div class=\"text-5xl mb-4\">✝️</div><h3 class=\"font-display text-2xl text-church-dark mb-3\">The Word</h3><p class=\"font-body text-[#6a5a50] leading-relaxed text-sm\">Scripture is our sole foundation. We order every aspect of our lives by the light of God&#x27;s Word.</p></div><div class=\"bg-white p-8 border-b-4 border-church-blue shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center\"><div class=\"text-5xl mb-4\">📢</div><h3 class=\"font-display text-2xl text-church-dark mb-3\">Gospel</h3><p class=\"font-body text-[#6a5a50] leading-relaxed text-sm\">Proclaiming the Good News of Jesus Christ is central to everything we do, both within our walls and beyond.</p></div><div class=\"bg-white p-8 border-b-4 border-church-blue shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center\"><div class=\"text-5xl mb-4\">🌍</div><h3 class=\"font-display text-2xl text-church-dark mb-3\">Service</h3><p class=\"font-body text-[#6a5a50] leading-relaxed text-sm\">Serving our community and carrying the Gospel to all people is our unwavering commitment.</p></div></div></section><section class=\"py-24 px-6 bg-white\"><div class=\"max-w-5xl mx-auto flex flex-col md:flex-row gap-12 items-center\"><div class=\"flex-shrink-0 relative\"><div class=\"absolute -inset-4 border border-gold/30\"></div><div class=\"relative w-64 h-80 overflow-hidden shadow-2xl\"><img alt=\"Pastor Beza Merne\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fpastor.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute -bottom-4 -right-4 bg-church-blue text-white px-4 py-2\"><span class=\"font-accent text-xs tracking-widest uppercase\">Lead Pastor</span></div></div><div><span class=\"font-accent uppercase tracking-[4px] text-xs text-church-blue block mb-2\">Our Pastor</span><h2 class=\"font-display text-4xl text-church-dark font-bold mb-2\">Pastor Beza Merne</h2><p class=\"font-accent italic text-gold text-lg mb-6\">ፓስተር ቤዛ መርኔ</p><div class=\"w-12 h-0.5 bg-gradient-to-r from-church-blue to-gold mb-6\"></div><p class=\"font-body text-[#5a4a40] leading-relaxed mb-4 text-sm\">Pastor Beza Merne is the Lead Pastor of Christ Saints&#x27; Church. His heart is set on delivering God&#x27;s Word to people, strengthening fellowship, and growing the church community.</p><p class=\"font-body text-[#5a4a40] leading-relaxed mb-6 text-sm\">Love and humility are the hallmarks of his life. He prays for every individual and has devoted himself to seeing all people come to Christ.</p><blockquote class=\"border-l-4 border-gold pl-4 mb-6\"><p class=\"font-accent italic text-gold text-base\">“For to me, to live is Christ and to die is gain.”</p><cite class=\"font-body text-gold/50 text-xs\">— Philippians 1:21</cite></blockquote><a class=\"inline-flex items-center gap-2 text-church-blue font-body text-sm hover:text-church-blue-light transition-colors group\" href=\"/pastor\">Read more about the Pastor<span class=\"group-hover:translate-x-1 transition-transform\">→</span></a></div></div></section><section class=\"relative py-20 px-6 overflow-hidden\" style=\"background:linear-gradient(135deg, #071428 0%, #155A9E 50%, #1E6CB8 100%)\"><div class=\"absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(201,168,76,0.1)_0%,transparent_70%)] pointer-events-none\"></div><div class=\"relative z-10 max-w-3xl mx-auto text-center\"><h2 class=\"font-display text-4xl md:text-5xl text-white font-bold mb-4\">Growing<!-- --> <span class=\"text-shimmer\">Together in Christ</span></h2><p class=\"font-body text-white/65 text-base leading-relaxed mb-8\">Our church welcomes everyone. Prayer and praise are open to all — come and be part of the family.</p><a class=\"inline-block bg-gold hover:bg-gold-light text-church-dark font-body font-semibold px-10 py-4 transition-all duration-300 hover:shadow-2xl hover:shadow-gold/30 hover:-translate-y-1\" href=\"/contact\">Join Us Today →</a></div></section><!--$--><!--/$--></main><footer class=\"bg-church-dark border-t border-gold/15\"><div class=\"max-w-7xl mx-auto px-6 py-16\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\"><div><div class=\"flex items-center gap-3 mb-4\"><div class=\"relative w-14 h-14 rounded-full border-2 border-gold overflow-hidden\"><img alt=\"Logo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75\"/></div><div><p class=\"font-display text-gold text-base font-bold\">Christ Saints&#x27; Church</p><p class=\"font-body text-white/40 text-xs\">ክርስቶስ ቅዱሳን ቤተክርስቲያን</p></div></div><p class=\"font-body text-white/50 text-sm leading-relaxed mt-4\">ፍቅር፣ ተስፋ፣ ሕይወት — በኢየሱስ ክርስቶስ ስም አብሮ እናገለግላለን።</p></div><div><h4 class=\"font-accent text-gold text-lg mb-5 tracking-widest uppercase text-sm\">Links</h4><ul class=\"space-y-3\"><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/about\">About</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/pastor\">Pastor</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/sermons\">Sermons</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/events\">Events</a></li><li><a class=\"font-body text-white/50 hover:text-gold transition-colors text-sm\" href=\"/contact\">Contact</a></li></ul></div><div><h4 class=\"font-accent text-gold tracking-widest uppercase text-sm mb-5\">Worship Schedule</h4><div class=\"space-y-3\"><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Sunday<!-- --> — <!-- -->2:00 - 4:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Worship</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Wednesday<!-- --> — <!-- -->7:00 - 8:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Bible Study</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Saturday<!-- --> — <!-- -->11:00 AM - 1:00 PM</span><span class=\"font-body text-white/35 text-xs block\">Prayer Meeting (Every Two Weeks)</span></div></div><div class=\"flex items-center gap-3\"><div class=\"w-1 h-1 rounded-full bg-gold flex-shrink-0\"></div><div><span class=\"font-body text-white/70 text-sm\">Sunday<!-- --> — <!-- -->2:00 - 4:30 PM</span><span class=\"font-body text-white/35 text-xs block\">Youth Group (Sunday School)</span></div></di